# ============================================================
# 1) Provider chuno (groq | openrouter | gemini | mistral | ollama)
#    Groq ya Gemini sabse aasan hai — dono free, no credit card.
# ============================================================
PROVIDER=groq

# ============================================================
# 2) Jo provider chuna hai, uski key yahan daalo
#    (sirf ek key chahiye, baaki comment rehne do)
# ============================================================

# Groq  -> https://console.groq.com/keys          (free, no card)
GROQ_API_KEY=

# OpenRouter -> https://openrouter.ai/keys        (free models, 50 req/day)
OPENROUTER_API_KEY=

# Google Gemini -> https://aistudio.google.com/apikey   (free, no card)
GEMINI_API_KEY=

# Mistral -> https://console.mistral.ai/api-keys  (free experiment tier)
MISTRAL_API_KEY=

# DeepSeek -> https://platform.deepseek.com/api_keys
# NOTE: DeepSeek API free NAHI hai. Naye account pe 5M free token (30 din),
#       uske baad top-up karna padta hai (deepseek-flash sabse sasta).
DEEPSEEK_API_KEY=

# Ollama local hai, key ki zaroorat nahi
OLLAMA_API_KEY=ollama

# ============================================================
# 3) Optional: model override (khali chhodo to default chalega)
# ============================================================
# AGENT_MODEL=openai/gpt-oss-120b

# ============================================================
# 4) Ollama (local / VM) — unlimited, free, no key
#    Local: default localhost. Remote VM pe chal raha ho to IP daalo.
# ============================================================
# OLLAMA_BASE_URL=http://localhost:11434/v1
# AGENT_MODEL=qwen2.5-coder:7b
