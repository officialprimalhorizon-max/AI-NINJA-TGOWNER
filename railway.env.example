# =============================================================================
#  RAILWAY VARIABLES — copy-paste karo (Settings -> Variables)
#  Railpack "Raw Editor" me poora paste kar sakte ho.
# =============================================================================

# --- ZAROORI -----------------------------------------------------------------
# Login password (strong rakho). Iske bina koi bhi tumhara agent chala lega.
APP_PASSWORD=change-this-to-strong-password

# Cookie/token signing key. Koi bhi random 40+ chars.
SECRET_KEY=change-this-to-40-random-hex-characters

# Volume mount path — Settings -> Volumes me bhi /data mount karna hai
DATA_DIR=/data

# =============================================================================
#  AI PROVIDER — 2 me se ek chuno
# =============================================================================

# ✅ OPTION 1 (FAST + FREE, recommended): Groq
#    1. https://console.groq.com/keys -> Google login -> Create API Key
#    2. yahan paste karo
#    Free: 30 req/min, ~1000 req/day. Speed: 1-2 second.
#    Multiple keys comma se: gsk_a,gsk_b,gsk_c
GROQ_API_KEY=

# ✅ OPTION 2 (BILKUL ZERO SETUP): kuch bhi mat daalo
#    App khud Pollinations keyless mode chalayega.
#    Trade-off: 30 second me 1 request (slow, par free forever)


# --- OPTIONAL (fallback chain) ----------------------------------------------
# Groq ki limit khatam ho to khud inme gir jayega
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# =============================================================================
#  MODEL override (khali chhodo to auto)
# =============================================================================
# GROQ ke liye: openai/gpt-oss-120b
# GEMINI ke liye: gemini-3.8-flash
# AGENT_MODEL=
